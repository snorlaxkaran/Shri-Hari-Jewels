# Optional override for demo-request email alerts (defaults to all SuperAdmin users)
# PLATFORM_DEMO_EMAIL=admin@karan.com

# Email (required for demo-request alerts and payroll/report attachments)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Shri Hari Jewels <you@gmail.com>"

# Platform subscription support contact (shown to tenants on billing/lockout screens)
# PLATFORM_CONTACT_PHONE=+91-XXXXXXXXXX
# PLATFORM_CONTACT_EMAIL=support@example.com
# PLATFORM_CONTACT_WHATSAPP=+91-XXXXXXXXXX

# Trial signup OTP — sent as SMS to the user's Messages app
# Provider: twilio (default) | fast2sms | msg91 | log (dev only, no SMS)
SMS_PROVIDER=twilio

# Twilio (https://console.twilio.com) — Phone Numbers → buy a number with SMS
# Trial accounts: verify recipient numbers under Phone Numbers → Verified Caller IDs
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_SMS_FROM=+1XXXXXXXXXX
# Or use a Messaging Service instead of TWILIO_SMS_FROM:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fast2SMS alternative (India, DLT required)
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=
# FAST2SMS_OTP_ID=

# MSG91 alternative (India)
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=

# Fallback: show OTP on screen when Twilio is not configured yet
# TRIAL_OTP_ECHO=true

# SUBSCRIPTION_DEFAULT_MONTHLY_AMOUNT=5000

# Sandbox base URL: https://einv1api.gstsandbox.nic.in/
# Production base URL: provided by GSTN after API registration
# EINVOICE_NIC_BASE_URL=https://einv1api.gstsandbox.nic.in/
# EINVOICE_CLIENT_ID=
# EINVOICE_CLIENT_SECRET=
# EINVOICE_GSTIN=
# EINVOICE_USERNAME=
# EINVOICE_PASSWORD=
# EINVOICE_NIC_PUBLIC_KEY=
