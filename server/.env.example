# Optional override for demo-request email alerts (defaults to all SuperAdmin users)
# PLATFORM_DEMO_EMAIL=admin@karan.com

# Email (required for demo-request alerts and payroll/report attachments)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Shri Hari Jewels <you@gmail.com>"

# Platform subscription support contact (shown to tenants on billing/lockout screens)
# PLATFORM_CONTACT_PHONE=+91-XXXXXXXXXX
# PLATFORM_CONTACT_EMAIL=support@example.com
# PLATFORM_CONTACT_WHATSAPP=+91-XXXXXXXXXX

# Default monthly subscription amount for new tenants (INR)
# SUBSCRIPTION_DEFAULT_MONTHLY_AMOUNT=5000

# Sandbox base URL: https://einv1api.gstsandbox.nic.in/
# Production base URL: provided by GSTN after API registration
# EINVOICE_NIC_BASE_URL=https://einv1api.gstsandbox.nic.in/
# EINVOICE_CLIENT_ID=
# EINVOICE_CLIENT_SECRET=
# EINVOICE_GSTIN=
# EINVOICE_USERNAME=
# EINVOICE_PASSWORD=
# EINVOICE_NIC_PUBLIC_KEY=
